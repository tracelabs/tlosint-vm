# Builder image for TLOSINT VM - Debian Trixie ARM64
# CIS Docker Benchmark v1.6.0 applied where practical
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

# HTTPS support
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# configure apt sources
RUN echo 'deb https://deb.debian.org/debian trixie main contrib non-free non-free-firmware' > /etc/apt/sources.list \
    && echo 'deb https://security.debian.org/debian-security trixie-security main contrib non-free non-free-firmware' >> /etc/apt/sources.list \
    && echo 'deb https://deb.debian.org/debian trixie-updates main contrib non-free non-free-firmware' >> /etc/apt/sources.list \
    && echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80-retries \
    && echo 'Acquire::https::Timeout "30";' >> /etc/apt/apt.conf.d/80-retries

# install debos and all build-time dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bmap-tools \
       debos \
       dosfstools \
       e2fsprogs \
       linux-image-arm64 \
       p7zip-full \
       parted \
       qemu-utils \
       systemd-resolved \
       xz-utils \
       zerofree \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* \
    && rm -rf /var/cache/apt/archives/*.deb

# create non-root user and workspace
RUN groupadd -r tlosint -g 1000 \
    && useradd -r -u 1000 -g tlosint -m -s /bin/bash tlosint \
    && mkdir -p /home/tlosint/workspace /recipes \
    && chown -R tlosint:tlosint /home/tlosint /recipes

# permissions
RUN chmod 750 /home/tlosint \
    && chmod 700 /root \
    && find /usr/bin /usr/sbin -perm /4000 -type f -exec chmod u-s {} \; || true \
    && find /usr/bin /usr/sbin -perm /2000 -type f -exec chmod g-s {} \; || true

WORKDIR /home/tlosint/workspace

USER tlosint

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD [ "test", "-d", "/home/tlosint" ] || exit 1
